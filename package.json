{
  "name": "bridgekit",
  "version": "0.5.0",
  "private": true,
  "description": "Inspect, profile and reversibly patch compatible Electron apps with permission-scoped plugins",
  "main": "patcher/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "faceit:status": "node tools/faceit.cjs status",
    "faceit:install": "node tools/faceit.cjs install",
    "faceit:uninstall": "node tools/faceit.cjs uninstall",
    "demo": "node tools/demo.cjs",
    "verify": "node tools/demo.cjs --verify",
    "faceit:verify": "node tools/verify-faceit.cjs",
    "verify:adapter": "node tools/demo.cjs --verify --faceit-adapter",
    "faceit:update": "node tools/faceit.cjs update",
    "forecast:verify": "node tools/verify-forecast.cjs",
    "forecast:verify-installed": "node tools/verify-forecast.cjs --installed",
    "manager:test": "node --test tests/registry.test.cjs tests/controller.test.cjs tests/manager.test.cjs tests/chrome-manager.test.cjs tests/manager-ui.test.cjs",
    "manager:verify": "node tools/verify-manager.cjs",
    "manager:verify-installed": "node tools/verify-manager.cjs --installed",
    "compat:verify": "node tools/verify-compat.cjs",
    "compat:verify-installed": "node tools/verify-compat.cjs --installed",
    "ad-cleaner:verify": "node tools/verify-ad-cleaner.cjs",
    "bridgekit": "node tools/bridgekit.cjs",
    "start": "node tools/start-patcher.cjs",
    "patcher": "node tools/start-patcher.cjs",
    "patcher:verify": "node tools/verify-patcher.cjs",
    "picker:verify": "node tools/verify-picker.cjs",
    "wand:verify": "node tools/verify-wand-plugins.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "jsdom": "26.1.0"
  },
  "dependencies": {
    "@electron/fuses": "2.1.3",
    "adm-zip": "0.6.1",
    "electron-chrome-extensions": "4.10.0"
  },
  "productName": "BridgeKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babymonie/bridgekit.git"
  },
  "bugs": {
    "url": "https://github.com/babymonie/bridgekit/issues"
  },
  "homepage": "https://github.com/babymonie/bridgekit#readme",
  "bin": {
    "bridgekit": "tools/bridgekit.cjs"
  }
}
